# Brand name shown in the navbar, footer and metadata.
NEXT_PUBLIC_BRAND_NAME="Lumen Attend"

# Optional: absolute site URL used for metadata (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=

# Never commit real values: copy this file to .env.local, or set them in your host.
# ---- Contact form delivery -------------------------------------------------
# Configure ONE of the options below (if several are set, the first wins). If
# none is configured, the contact form returns a clear "service unavailable"
# error instead of faking success.

# Where enquiries are delivered. Comma-separate for several addresses.
# Optional with Gmail (defaults to GMAIL_USER); required with Resend.
CONTACT_TO_EMAIL=

# Option A: your Gmail account (free, ~500 emails/day)
# Sends each enquiry to you AND a confirmation email to the submitter, both
# from your Gmail. Needs 2-Step Verification and an App Password from
# https://myaccount.google.com/apppasswords (not your normal Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: set to "false" to stop the confirmation email to submitters.
CONTACT_SEND_CONFIRMATION=
# Optional: replace the main paragraph of the confirmation email.
CONTACT_CONFIRMATION_MESSAGE=

# Option B: email via Resend (https://resend.com). Notifies you only.
RESEND_API_KEY=
# Must be on a domain verified with Resend. Without one, use Resend's test sender:
#   Website Enquiries <onboarding@resend.dev>
# (it can only deliver to the email address of your Resend account).
CONTACT_FROM_EMAIL=

# Option C: generic webhook (Zapier, Make, Slack workflow, your own API, ...)
# Receives a JSON POST containing the validated submission.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=
